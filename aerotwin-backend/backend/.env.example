# Copy this file to `.env` (same folder) and edit the values below.
# `.env` is loaded automatically by app/config.py - never commit your real .env
# if this ever goes in a public git repo (it may contain a local Windows path).

# ---------------------------------------------------------------------------
# REQUIRED: where the raw NGAFID dataset lives on YOUR machine.
# This folder must directly contain: flight_header.csv, flight_data.pkl, stats.csv
# Use forward slashes even on Windows (Python accepts both, forward slashes avoid
# accidental escape-character issues with backslashes).
# ---------------------------------------------------------------------------
NGAFID_DATA_PATH=C:/Users/YOUR_NAME/Datasets/ngafid

# Only set these if your files are named differently from the defaults:
# FLIGHT_HEADER_FILENAME=flight_header.csv
# FLIGHT_DATA_FILENAME=flight_data.pkl
# STATS_FILENAME=stats.csv

# ---------------------------------------------------------------------------
# OPTIONAL: server settings
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Defaults already cover CRA (3000) and Vite (5173/4173) on localhost/127.0.0.1.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# OPTIONAL: demo behaviour
# ---------------------------------------------------------------------------
# Pin a specific flight_id to use as the "current engine" in /api/engine/status
# and /api/dashboard/summary when the frontend doesn't pass ?flight_id=.
# Leave blank to just use the first flight in the dataset.
# DEMO_FLIGHT_ID=12345

# How many points GET /api/replay/{flight_id} and telemetry endpoints return
# at most (downsampled for smooth charting).
# REPLAY_MAX_POINTS=500

# Delay between points streamed over /ws/telemetry/{flight_id}, in milliseconds.
# WS_DEFAULT_INTERVAL_MS=100

# Health index status thresholds (0-100 scale).
# HEALTH_THRESHOLD_WARNING=75
# HEALTH_THRESHOLD_CRITICAL=40
